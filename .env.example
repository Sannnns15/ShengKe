# ═══════════════════════════════════════════════════
# ShengKe（生刻）环境变量配置示例
# 复制此文件为 .env 并填写实际值
# ═══════════════════════════════════════════════════

# ── App ──
APP_NAME=ShengKe API
APP_VERSION=0.1.0
DEBUG=true

# ── Database (PostgreSQL) ──
DATABASE_URL=postgresql+asyncpg://shengke:shengke_secret@localhost:5432/shengke_dev
DATABASE_SYNC_URL=postgresql://shengke:shengke_secret@localhost:5432/shengke_dev

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── JWT ──
JWT_SECRET=change-me-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Ali OSS（可选，开发时可用本地文件代替）──
ALI_OSS_ENDPOINT=
ALI_OSS_BUCKET=
ALI_OSS_ACCESS_KEY_ID=
ALI_OSS_ACCESS_KEY_SECRET=

# ── Ali LLM（通义千问，可选）──
ALI_LLM_API_KEY=
ALI_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALI_LLM_MODEL=qwen-turbo

# ── CORS ──
CORS_ORIGINS=["*"]
